# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# python (api/*.py Vercel functions)
__pycache__/
*.pyc

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.env.local

# local scratch test fixtures (real pipeline output used for debugging,
# not permanent reference fixtures -- kept local, not committed)
/reference/sample_plan_2.pdf
/reference/sample_plan_2_broken.pdf
/reference/sample_plan_broken_de.pdf
/reference/sample_plan_broken_es.pdf
/reference/font_bugs.pdf

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js (next-auth v4 + @auth/prisma-adapter) standard schema for
// Google OAuth sign-in. Database session strategy, not JWT -- sessions
// and OAuth accounts both live here so "connect once" survives across
// stateless Vercel function invocations. drive.file scope/refresh-token
// handling arrives with the Drive-upload feature; Account already has
// the columns for it (refresh_token etc.), encrypt that column at rest
// once it's actually populated -- see CLAUDE.md.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Dynamic (Gemini-generated) translation memory cache. Keyed on stripped,
// lowercased source text -- distinct from api/glossary.py's hand-curated
// GLOSSARY dict, which stays a checked-in Python file and preserves raw
// whitespace as a load-bearing match key. See PROJECT_STATE.md.
model GlossaryTerm {
  id              Int      @id @default(autoincrement())
  sourceText      String   @map("source_text")
  sourceTextLower String   @map("source_text_lower")
  targetLang      String   @map("target_lang")
  translation     String
  source          String   @default("gemini")
  model           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([sourceTextLower, targetLang])
  @@map("glossary_terms")
}
